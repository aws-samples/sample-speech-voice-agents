# Copy to .env at the repo root. Every agent in this sample loads this file via
# shared/model.py, so you set credentials and region once.
#
# Precedence: a variable already exported in your shell wins over this file.
# That includes the older AWS_DEFAULT_PROFILE / AWS_DEFAULT_REGION names, which
# boto3 checks before AWS_PROFILE / AWS_REGION. Every agent prints one line at
# startup showing the region and model actually in use, and warns if a shell
# variable overrode the region set here:
#   [aws] region=us-east-1  model=us.anthropic.claude-sonnet-...
# To confirm the account behind the active profile: aws sts get-caller-identity

# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# Model Configuration (optional)
# By default the agents discover the newest active Claude model on Bedrock.
# Pin a specific inference profile instead:
# STRANDS_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Turn discovery off and always use the built-in fallback model:
# STRANDS_MODEL_AUTO=0
